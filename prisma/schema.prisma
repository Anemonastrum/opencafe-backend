// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "ts"
}

datasource db {
  provider = "mysql"
}

// =========================
// ENUMS
// =========================

enum UserRole {
  ADMIN
  CASHIER
}

enum OrderStatus {
  PENDING
  COMPLETED
  CANCELLED
}

enum PaymentMethod {
  CASH
  QRIS
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  EXPIRED
}

// =========================
// USERS
// =========================

model User {
  id           Int      @id @default(autoincrement())
  name         String   @db.VarChar(100)
  username     String   @unique @db.VarChar(100)
  passwordHash String   @map("password_hash") @db.VarChar(255)
  imageUrl     String?  @map("image_url") @db.VarChar(500)
  role         UserRole @default(CASHIER)
  isActive     Boolean  @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  mustChangePassword Boolean @default(false) @map("must_change_password")

  orders Order[]
  sessions AuthSession[]

  @@map("users")
}

model AuthSession {
  id String @id @default(uuid()) @db.Char(36)
  userId Int @map("user_id")
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime @default(now()) @map("created_at")
  tokens RefreshToken[]

  @@index([userId])
  @@index([expiresAt])
  @@map("auth_sessions")
}

model RefreshToken {
  digest String @id @db.Char(64)
  sessionId String @map("session_id") @db.Char(36)
  session AuthSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  consumedAt DateTime? @map("consumed_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([sessionId])
  @@map("refresh_tokens")
}

// =========================
// CAFE SETTINGS
// =========================

model CafeSetting {
  id      Int     @id @default(1)
  name    String  @db.VarChar(150)
  logoUrl String? @map("logo_url") @db.VarChar(500)
  address String  @db.Text

  // Tax settings
  taxEnabled   Boolean @default(false) @map("tax_enabled")
  taxName      String  @default("PBJT") @map("tax_name") @db.VarChar(50)
  taxRate      Decimal @default(10.00) @map("tax_rate") @db.Decimal(5, 2)
  taxInclusive Boolean @default(false) @map("tax_inclusive")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("cafe_settings")
}

// =========================
// CATEGORIES
// =========================

model Category {
  id   Int    @id @default(autoincrement())
  name String @unique @db.VarChar(100)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  products Product[]

  @@map("categories")
}

// =========================
// PRODUCTS
// =========================

model Product {
  id          Int      @id @default(autoincrement())
  name        String   @db.VarChar(150)
  description String?  @db.Text
  imageUrl    String?  @map("image_url") @db.VarChar(500)
  price       Decimal  @db.Decimal(12, 2)
  isAvailable Boolean  @default(true) @map("is_available")

  categoryId Int?      @map("category_id")
  category   Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  orderItems OrderItem[]

  @@index([categoryId])
  @@map("products")
}

// =========================
// ORDERS
// =========================

model Order {
  id          Int         @id @default(autoincrement())
  orderNumber String      @unique @map("order_number") @db.VarChar(50)
  status      OrderStatus @default(PENDING)
  paymentHoldReason String? @map("payment_hold_reason") @db.VarChar(100)

  // Transaction amounts
  subtotalAmount Decimal @map("subtotal_amount") @db.Decimal(12, 2)
  totalAmount    Decimal @map("total_amount") @db.Decimal(12, 2)

  // Tax snapshot
  taxName      String? @map("tax_name") @db.VarChar(50)
  taxRate      Decimal @default(0) @map("tax_rate") @db.Decimal(5, 2)
  taxAmount    Decimal @default(0) @map("tax_amount") @db.Decimal(12, 2)
  taxInclusive Boolean @default(false) @map("tax_inclusive")

  // Cashier
  cashierId Int  @map("cashier_id")
  cashier   User @relation(fields: [cashierId], references: [id], onDelete: Restrict)

  // Receipt snapshots
  receiptCafeName    String? @map("receipt_cafe_name") @db.VarChar(150)
  receiptCafeAddress String? @map("receipt_cafe_address") @db.Text
  receiptLogoUrl     String? @map("receipt_logo_url") @db.VarChar(500)
  receiptCashierName String? @map("receipt_cashier_name") @db.VarChar(100)

  // Timestamps
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  completedAt DateTime? @map("completed_at")

  items   OrderItem[]
  payments Payment[]

  @@index([cashierId])
  @@index([status, createdAt])
  @@map("orders")
}

// =========================
// ORDER ITEMS
// =========================

model OrderItem {
  id Int @id @default(autoincrement())

  orderId Int   @map("order_id")
  order   Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  productId Int?     @map("product_id")
  product   Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  // Product snapshot
  productName String  @map("product_name") @db.VarChar(150)
  unitPrice   Decimal @map("unit_price") @db.Decimal(12, 2)
  quantity    Int
  subtotal    Decimal @db.Decimal(12, 2)

  @@index([orderId])
  @@index([productId])
  @@map("order_items")
}

// =========================
// PAYMENTS
// =========================


model Payment {
  id Int @id @default(autoincrement())

  // Order relationship
  orderId Int @map("order_id")
  order   Order @relation(fields: [orderId], references: [id], onDelete: Restrict)

  attemptNumber Int @default(1) @map("attempt_number")
  requestId String? @map("request_id") @db.Char(36)
  orderTotalAmount Decimal? @map("order_total_amount") @db.Decimal(12, 2)
  roundingAdjustment Decimal? @map("rounding_adjustment") @db.Decimal(12, 2)
  dispatchClaimedAt DateTime? @map("dispatch_claimed_at")
  dispatchFinishedAt DateTime? @map("dispatch_finished_at")
  reconciliationReason String? @map("reconciliation_reason") @db.VarChar(100)
  latestProviderObservation Json? @map("latest_provider_observation")
  settlementObservation Json? @map("settlement_observation")

  // Payment details
  method PaymentMethod
  status PaymentStatus @default(PENDING)

  amount Decimal @db.Decimal(12, 2)

  // Cash payment
  cashReceived Decimal? @map("cash_received") @db.Decimal(12, 2)
  changeAmount Decimal? @map("change_amount") @db.Decimal(12, 2)

  // Midtrans payment
  midtransOrderId String? @unique @map("midtrans_order_id") @db.VarChar(100)

  midtransTransactionId String? @unique @map("midtrans_transaction_id") @db.VarChar(100)

  midtransStatus String? @map("midtrans_status") @db.VarChar(30)

  // QRIS payment
  qrisQrUrl String? @map("qris_qr_url") @db.Text
  qrisPayload String? @map("qris_payload") @db.Text

  // Optional: Midtrans Snap
  snapToken String? @map("snap_token") @db.Text
  snapRedirectUrl String? @map("snap_redirect_url") @db.Text

  // Timestamps
  expiresAt DateTime? @map("expires_at")
  paidAt DateTime? @map("paid_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([orderId, attemptNumber])
  @@unique([orderId, requestId])
  @@index([status])
  @@map("payments")
}
