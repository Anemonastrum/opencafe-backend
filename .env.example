# Percent-encode reserved characters in database username/password.
DATABASE_URL=mysql://USER:PASSWORD@127.0.0.1:3306/opencafe
PORT=3000
APP_ORIGIN=http://localhost:3000
# Generate: node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
NODE_ENV=development

# Optional: explicitly authorized fixture-writing test DB, never production.
TEST_DATABASE_URL=
TEST_DATABASE_ACK=
